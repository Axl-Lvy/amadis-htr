.venv/
__pycache__/
*.pyc
.pytest_cache/
uv.lock.bak

# Recovered artefacts land here and are vendored deliberately, never bulk-added.
data/runs/**/*.raw

# LaTeX build products. The PDF is a release artefact, not a repository file.
report/main.pdf
report/main-fr.pdf
report/*.aux
report/*.bbl
report/*.bcf
report/*.blg
report/*.log
report/*.run.xml
report/*.synctex.gz
report/*-blx.bib

# git worktrees created for parallel work
.worktrees/

# Inspection renders of the generated figures. The PDF is the artefact; a PNG
# beside it is something someone made to look at and forgot to delete.
report/generated/figures/*.png
report/generated/fr/figures/*.png
